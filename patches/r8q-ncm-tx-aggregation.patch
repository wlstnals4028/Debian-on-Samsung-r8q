+/* All aggregate state is protected by tx_lock. */
+static void ncm_purge_tx_locked(struct f_ncm *ncm)
+{
+	dev_kfree_skb_any(ncm->skb_tx_data);
+	dev_kfree_skb_any(ncm->skb_tx_ndp);
+	ncm->skb_tx_data = NULL;
+	ncm->skb_tx_ndp = NULL;
+	ncm->ndp_dgram_count = 0;
+}
+
+static void ncm_stop_tx(struct f_ncm *ncm)
+{
+	unsigned long flags;
+
+	WRITE_ONCE(ncm->timer_stopping, true);
+	hrtimer_try_to_cancel(&ncm->task_timer);
+	spin_lock_irqsave(&ncm->tx_lock, flags);
+	ncm_purge_tx_locked(ncm);
+	spin_unlock_irqrestore(&ncm->tx_lock, flags);
+}
+
+static struct sk_buff *package_for_tx(struct f_ncm *ncm)
+{
+	const struct ndp_parser_opts *opts = ncm->parser_opts;
+	const unsigned ndp_align = le16_to_cpu(ntb_parameters.wNdpInAlignment);
+	const unsigned dpe_len = 4 * opts->dgram_item_len;
+	struct sk_buff *skb = ncm->skb_tx_data;
+	unsigned ndp_index, ndp_pad, block_len;
+	__le16 *p;
+
+	if (!skb)
+		return NULL;
+
+	hrtimer_try_to_cancel(&ncm->task_timer);
+	ndp_index = ALIGN(skb->len, ndp_align);
+	ndp_pad = ndp_index - skb->len;
+	block_len = ndp_index + ncm->skb_tx_ndp->len + dpe_len;
+
+	/* NTH: BlockLength followed by the first NDP index. */
+	p = (void *)(skb->data + 8);
+	put_ncm(&p, opts->block_length, block_len);
+	put_ncm(&p, opts->ndp_index, ndp_index);
+
+	/* NDP: its length includes the terminating zero entry. */
+	put_unaligned_le16(ncm->skb_tx_ndp->len + dpe_len,
+			   ncm->skb_tx_ndp->data + 4);
+	skb_put_zero(skb, ndp_pad);
+	skb_put_data(skb, ncm->skb_tx_ndp->data, ncm->skb_tx_ndp->len);
+	skb_put_zero(skb, dpe_len);
+
+	dev_consume_skb_any(ncm->skb_tx_ndp);
+	ncm->skb_tx_ndp = NULL;
+	ncm->skb_tx_data = NULL;
+	ncm->ndp_dgram_count = 0;
+	return skb;
+}
