+static enum hrtimer_restart ncm_tx_timeout(struct hrtimer *timer)
+{
+	struct f_ncm *ncm = container_of(timer, struct f_ncm, task_timer);
+	struct net_device *net = READ_ONCE(ncm->netdev);
+	netdev_tx_t status;
+
+	if (READ_ONCE(ncm->timer_stopping) || !net)
+		return HRTIMER_NORESTART;
+
+	/* u_ether already accepts NULL skbs for multi-frame protocol flushes. */
+	status = net->netdev_ops->ndo_start_xmit(NULL, net);
+	if (status == NETDEV_TX_BUSY && !READ_ONCE(ncm->timer_stopping)) {
+		/* No USB request available: retry so sparse traffic is not stranded. */
+		hrtimer_forward_now(timer, ns_to_ktime(TX_TIMEOUT_NSECS));
+		return HRTIMER_RESTART;
+	}
+	return HRTIMER_NORESTART;
 }
 
