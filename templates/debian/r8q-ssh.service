[Unit]
Description=SSH access over r8q USB network
After=network.target

[Service]
Type=simple
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755
ExecStartPre=/usr/sbin/sshd -t -f /etc/ssh/sshd_config.r8q
ExecStart=/usr/sbin/sshd -D -e -f /etc/ssh/sshd_config.r8q
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
